# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make extension TARGET_ARCH=arm64`).

# --- Talos --------------------------------------------------------------------------
# Used only for the extension manifest's `compatibility.talos.version` field and the
# published image tag - unlike ../talos-awg-extension, this repo has no kernel-module
# dependency on ../talos-kernel at all, so this doesn't need to match that repo's pin.
TALOS_VERSION=v1.14.0

# siderolabs/extensions checkout used to package this extension via its own
# pkg.yaml/bldr pipeline. A release tag rather than a commit: upstream tags one per Talos
# version, so this says which Talos the packaging came from instead of naming a commit
# that says nothing on its own. Derived rather than repeated, since the two must agree and
# a second literal is a second thing to forget - this form expands both when the Makefile
# includes this file and when a shell sources it.
UPSTREAM_EXTENSIONS_REF=${TALOS_VERSION}

# --- the thing we actually package ---------------------------------------------
# BIRD arrives as a published image rather than being built here: slipmesh/bird already
# builds it statically from upstream, and a second build of the same thing is a second
# thing to keep current. Pulling a layer also drops the source download this used to do
# from gitlab.nic.cz, whose archive endpoint throttles unauthenticated requests
# (`throttle_unauthenticated_web`, 7 per window) and answers with a short error body that
# fails the build as a checksum mismatch.
BIRD_IMAGE=ghcr.io/slipmesh/bird
BIRD_IMAGE_TAG=v0.1.2-bird2.19.2

# The BIRD inside that image. Not a build input - it names the extension's own version
# and release tag, so it has to be bumped alongside BIRD_IMAGE_TAG.
BIRD_VERSION=2.19.2

# --- the daemon that ships inside the extension --------------------------------------
# slipmesh/talos-extensions release tag holding the daemon and its extension-services
# manifest. `make check-daemons` refuses to build unless the sibling checkout sits at it;
# DAEMONS_SHA (Makefile) only records what was used, it never constrained it.
DAEMONS_REF=v0.1.6

# --- where the artifacts go -------------------------------------------------------
IMAGE=ghcr.io/slipmesh/talos-router-extension
