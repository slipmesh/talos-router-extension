# Single source of truth for everything this build pins. Sourced by the Makefile;
# override any of it on the command line (e.g. `make extension TARGET_ARCH=arm64`).

# --- Talos --------------------------------------------------------------------------
# Used only for the extension manifest's `compatibility.talos.version` field and the
# published image tag - unlike ../talos-awg-extension, this repo has no kernel-module
# dependency on ../talos-kernel at all, so this doesn't need to match that repo's pin.
TALOS_VERSION=v1.13.9

# siderolabs/extensions checkout used to package this extension via its own
# pkg.yaml/bldr pipeline. Pinned for reproducibility; bump freely, `make
# checkout-extensions` just needs it to resolve.
UPSTREAM_EXTENSIONS_REF=30067720457851d26682a0bcf50165efac3059c0

# --- the thing we actually package ---------------------------------------------
# BIRD (gitlab.nic.cz/labs/bird) - built from source with both `bird` and `birdc` (see
# patches/extensions/router/pkg.yaml for why this isn't just siderolabs/extensions' own
# network/bird2 package). Pin mirrors bird2's own pkg.yaml at the time this was written;
# regenerate the hashes with `make hashes` after changing the version.
BIRD_VERSION=2.18
BIRD_SHA256=fa0785d36200a1950b85d9806360648b7c85cd4498088ede3f95ca031b1d70ee
BIRD_SHA512=7c369a534b3377a2b1754c653ad556d6434da49d4c4b10c7184881e4079906e9008cd9cac1b643832bcd2526b1dedd9030899ebd1e344eed9f44473f13a8db2c

# --- where the artifacts go -------------------------------------------------------
IMAGE=ghcr.io/slipmesh/talos-router-extension
